instance:
  id: {{ .Variables.id | toJson }}
  login: {{ .Variables.login | toJson }}
  registryUID: {{ .Variables.registryUID | toJson }}
  syncEpoch: {{ if regexMatch "^[0-9]{1,18}$" .Variables.syncEpoch }}{{ .Variables.syncEpoch }}{{ else }}{{ .Variables.syncEpoch | toJson }}{{ end }}
  public: {{ if has .Variables.public (list "true" "false") }}{{ .Variables.public }}{{ else }}{{ .Variables.public | toJson }}{{ end }}
storage:
  bucket: {{ .Variables.bucket | toJson }}
  endpoint: {{ .Variables.endpoint | toJson }}
  region: {{ .Variables.region | toJson }}
vault:
  secretPath: {{ .Variables.vaultSecretPath | toJson }}
  authMount: {{ .Variables.vaultAuthMount | toJson }}
  role: {{ .Variables.vaultRole | toJson }}
